<!--
  Panel de escena: tamano de la esfera y modo de inmersion.

  Ojo con el bloque <style>: el parser de UIKitML NO soporta comentarios CSS
  /* ... */ y descarta la regla que los sigue, sin warning. Los comentarios de
  markup como este si funcionan.
-->
<style>
  @font-face {
    font-family: "DM Sans";
    src: url("https://fonts.gstatic.com/s/dmsans/v17/rP2tp2ywxg089UriI5-g4vlH9VoD8CmcqZG40F9JadbnoEwAopxhTg.ttf");
    font-weight: 400;
  }

  @font-face {
    font-family: "DM Sans";
    src: url("https://fonts.gstatic.com/s/dmsans/v17/rP2tp2ywxg089UriI5-g4vlH9VoD8CmcqZG40F9JadbnoEwAkJxhTg.ttf");
    font-weight: 500;
  }

  @font-face {
    font-family: "DM Sans";
    src: url("https://fonts.gstatic.com/s/dmsans/v17/rP2tp2ywxg089UriI5-g4vlH9VoD8CmcqZG40F9JadbnoEwARZthTg.ttf");
    font-weight: 700;
  }

  .panel-root {
    flex-direction: column;
    font-family: "DM Sans";
    width: 344px;
  }

  .panel-content {
    align-items: center;
    flex-direction: column;
    padding-top: 16px;
    padding-left: 24px;
    padding-right: 24px;
  }

  .heading {
    height: 26px;
    text-align: center;
    font-size: 19px;
    font-weight: 700;
    line-height: 24px;
    letter-spacing: -0.5px;
    color: #272727;
  }

  .heading:dark {
    color: rgba(255, 255, 255, 0.9);
  }

  .control-label {
    color: #272727;
    font-size: 13px;
    font-weight: 700;
    width: 100%;
    margin-top: 18px;
    margin-bottom: 2px;
  }

  .control-label:dark {
    color: rgba(255, 255, 255, 0.9);
  }

  .readout {
    color: #6b6b6b;
    font-size: 11px;
    font-weight: 500;
    line-height: 14px;
    height: 14px;
    width: 100%;
    text-align: center;
    margin-top: 6px;
  }

  .readout:dark {
    color: rgba(255, 255, 255, 0.55);
  }

  .mode-row {
    flex-direction: row;
    width: 100%;
    gap: 10px;
    margin-top: 4px;
  }

  .mode-button {
    flex-grow: 1;
    justify-content: center;
  }

  .button {
    justify-content: flex-start;
    margin-left: 24px;
    margin-right: 24px;
    margin-top: 16px;
    margin-bottom: 20px;
  }

  .button-label {
    transform-translate-y: 1px;
  }
</style>
<Panel class="panel-root">
  <div class="panel-content">
    <div class="heading">Escena</div>

    <div class="control-label">Tamaño de la esfera</div>
    <Slider
      id="scale-slider"
      min="0.4"
      max="1.8"
      step="0.05"
      default-value="1"
      size="md"
      left-label="Chica"
      right-label="Grande"
    ></Slider>
    <div id="scale-readout" class="readout">1.00x</div>

    <div class="control-label">Modo</div>
    <div class="mode-row">
      <Button id="mode-ar" variant="primary" size="sm" class="mode-button">
        <ButtonLabel class="button-label">Passthrough</ButtonLabel>
      </Button>
      <Button id="mode-vr" variant="secondary" size="sm" class="mode-button">
        <ButtonLabel class="button-label">VR</ButtonLabel>
      </Button>
    </div>
    <div id="mode-readout" class="readout">Passthrough</div>
  </div>

  <Button id="scene-xr-button" variant="primary" class="button">
    <ButtonIcon>
      <RectangleGoggles></RectangleGoggles>
    </ButtonIcon>
    <ButtonLabel class="button-label"><span id="scene-xr-label">Entrar</span></ButtonLabel>
  </Button>
</Panel>
