<!--
  Panel de control del visualizador.

  Panel, Divider, Button, ButtonIcon, ButtonLabel y Slider vienen del kit
  Horizon que trae IWSDK. SkipBack, SkipForward, Play, RectangleGoggles y LogOut
  son iconos Lucide, tambien incluidos. No hay que registrar nada en codigo.
-->
<style>
  @font-face {
    font-family: "DM Sans";
    src: url("https://fonts.gstatic.com/s/dmsans/v17/rP2tp2ywxg089UriI5-g4vlH9VoD8CmcqZG40F9JadbnoEwAopxhTg.ttf");
    font-weight: 400;
  }

  @font-face {
    font-family: "DM Sans";
    src: url("https://fonts.gstatic.com/s/dmsans/v17/rP2tp2ywxg089UriI5-g4vlH9VoD8CmcqZG40F9JadbnoEwAkJxhTg.ttf");
    font-weight: 500;
  }

  @font-face {
    font-family: "DM Sans";
    src: url("https://fonts.gstatic.com/s/dmsans/v17/rP2tp2ywxg089UriI5-g4vlH9VoD8CmcqZG40F9JadbnoEwARZthTg.ttf");
    font-weight: 700;
  }

  .panel-root {
    flex-direction: column;
    font-family: "DM Sans";
    width: 344px;
  }

  .panel-content {
    align-items: center;
    flex-direction: column;
    padding-top: 16px;
    padding-left: 24px;
    padding-right: 24px;
  }

  .heading {
    height: 26px;
    text-align: center;
    font-size: 19px;
    font-weight: 700;
    line-height: 24px;
    letter-spacing: -0.5px;
    color: #272727;
  }

  .heading:dark {
    color: rgba(255, 255, 255, 0.9);
  }

  .track-name {
    color: #272727;
    font-size: 13px;
    font-weight: 700;
    line-height: 17px;
    height: 36px;
    width: 100%;
    text-align: center;
    margin-top: 8px;
  }

  .track-name:dark {
    color: rgba(255, 255, 255, 0.92);
  }

  .track-pos {
    color: #6b6b6b;
    font-size: 11px;
    font-weight: 500;
    line-height: 14px;
    height: 14px;
    width: 100%;
    text-align: center;
    margin-top: 4px;
    margin-bottom: 12px;
  }

  .track-pos:dark {
    color: rgba(255, 255, 255, 0.55);
  }

  .track-row {
    flex-direction: row;
    width: 100%;
    gap: 10px;
    margin-top: 2px;
    margin-bottom: 6px;
  }

  .track-button {
    flex-grow: 1;
    justify-content: center;
  }

  .control-label {
    color: #272727;
    font-size: 13px;
    font-weight: 700;
    width: 100%;
    margin-top: 14px;
    margin-bottom: 2px;
  }

  .control-label:dark {
    color: rgba(255, 255, 255, 0.9);
  }

  .button {
    justify-content: flex-start;
    margin-left: 24px;
    margin-right: 24px;
    margin-top: 12px;
  }

  .button-last {
    margin-bottom: 20px;
  }

  .button-label {
    transform-translate-y: 1px;
  }
</style>
<Panel class="panel-root">
  <div class="panel-content">
    <div class="heading">Point Cloud Visualizer</div>
    <div id="track-name" class="track-name">—</div>
    <div id="track-pos" class="track-pos">—</div>
    <div class="track-row">
      <Button id="prev-button" variant="secondary" size="sm" class="track-button">
        <ButtonIcon>
          <SkipBack></SkipBack>
        </ButtonIcon>
      </Button>
      <Button id="next-button" variant="secondary" size="sm" class="track-button">
        <ButtonIcon>
          <SkipForward></SkipForward>
        </ButtonIcon>
      </Button>
    </div>

    <div class="control-label">Sensibilidad</div>
    <!--
      Modo "uncontrolled": solo default-value, sin value. Si se setea value el
      componente espera que la app maneje el estado y el thumb no se mueve solo.
    -->
    <Slider
      id="sensitivity-slider"
      min="0"
      max="3"
      step="0.05"
      default-value="1"
      size="md"
      left-label="Suave"
      right-label="Intenso"
    ></Slider>
  </div>

  <Button id="play-button" variant="primary" class="button">
    <ButtonIcon>
      <Play></Play>
    </ButtonIcon>
    <!--
      El texto va en un <span> propio, no directo en ButtonLabel: ButtonLabel es
      un contenedor y setProperties({ text }) sobre el no hace nada — falla en
      silencio, sin warning. Los elementos de texto si responden.
    -->
    <ButtonLabel class="button-label"><span id="play-label">Play</span></ButtonLabel>
  </Button>

  <Button id="xr-button" variant="secondary" class="button button-last">
    <ButtonIcon>
      <RectangleGoggles></RectangleGoggles>
    </ButtonIcon>
    <ButtonLabel class="button-label">Enter XR</ButtonLabel>
  </Button>
  <Button
    id="exit-button"
    variant="secondary"
    class="button button-last"
    style="display: none"
  >
    <ButtonIcon>
      <LogOut></LogOut>
    </ButtonIcon>
    <ButtonLabel class="button-label">Salir de VR</ButtonLabel>
  </Button>
</Panel>
