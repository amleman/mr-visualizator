<style>
  @font-face {
    font-family: "DM Sans";
    src: url("https://fonts.gstatic.com/s/dmsans/v17/rP2tp2ywxg089UriI5-g4vlH9VoD8CmcqZG40F9JadbnoEwAopxhTg.ttf");
    font-weight: 400;
  }

  @font-face {
    font-family: "DM Sans";
    src: url("https://fonts.gstatic.com/s/dmsans/v17/rP2tp2ywxg089UriI5-g4vlH9VoD8CmcqZG40F9JadbnoEwAkJxhTg.ttf");
    font-weight: 500;
  }

  @font-face {
    font-family: "DM Sans";
    src: url("https://fonts.gstatic.com/s/dmsans/v17/rP2tp2ywxg089UriI5-g4vlH9VoD8CmcqZG40F9JadbnoEwARZthTg.ttf");
    font-weight: 700;
  }

  .dj-root {
    flex-direction: column;
    font-family: "DM Sans";
    width: 380px;
  }

  .dj-content {
    align-items: center;
    flex-direction: column;
    padding-top: 14px;
    padding-left: 20px;
    padding-right: 20px;
    padding-bottom: 18px;
  }

  .dj-title {
    height: 24px;
    text-align: center;
    font-size: 19px;
    font-weight: 700;
    line-height: 24px;
    letter-spacing: -0.5px;
    color: #272727;
  }

  .dj-title:dark {
    color: rgba(255, 255, 255, 0.95);
  }

  .section-label {
    color: #272727;
    font-size: 12px;
    font-weight: 700;
    width: 100%;
    margin-top: 10px;
    margin-bottom: 4px;
  }

  .section-label:dark {
    color: rgba(255, 255, 255, 0.85);
  }

  .radio-card {
    flex-direction: column;
    width: 100%;
    background-color: rgba(0, 0, 0, 0.05);
    border-radius: 8px;
    padding: 8px;
    margin-top: 2px;
    margin-bottom: 4px;
  }

  .radio-card:dark {
    background-color: rgba(255, 255, 255, 0.07);
  }

  .radio-info-row {
    flex-direction: row;
    justify-content: space-between;
    width: 100%;
    margin-bottom: 6px;
  }

  .radio-name {
    font-size: 13px;
    font-weight: 700;
    color: #1a1a1a;
  }

  .radio-name:dark {
    color: #ffffff;
  }

  .radio-genre {
    font-size: 11px;
    font-weight: 500;
    color: #666666;
  }

  .radio-genre:dark {
    color: rgba(255, 255, 255, 0.6);
  }

  .row-compact {
    flex-direction: row;
    width: 100%;
    gap: 8px;
  }

  .turntable-row {
    flex-direction: row;
    width: 100%;
    gap: 10px;
    margin-top: 6px;
    margin-bottom: 8px;
  }

  .pad-grid {
    flex-direction: column;
    width: 100%;
    gap: 8px;
    margin-top: 4px;
    margin-bottom: 6px;
  }

  .pad-row {
    flex-direction: row;
    width: 100%;
    gap: 8px;
  }

  .pad-btn {
    flex-grow: 1;
    justify-content: center;
    height: 38px;
  }

  .keyboard-row {
    flex-direction: row;
    width: 100%;
    gap: 5px;
    margin-top: 6px;
  }

  .key-btn {
    flex-grow: 1;
    justify-content: center;
    height: 42px;
    padding-left: 2px;
    padding-right: 2px;
  }

  .btn-label-text {
    transform-translate-y: 1px;
    font-size: 12px;
  }
</style>
<Panel class="dj-root">
  <div class="dj-content">
    <div class="dj-title">DJ Station</div>

    <!-- Seccion Radio Web en vivo -->
    <div class="radio-card">
      <div class="radio-info-row">
        <span id="radio-name" class="radio-name">Vaporwaves</span>
        <span id="radio-genre" class="radio-genre">Synthwave / Retro</span>
      </div>
      <div class="row-compact">
        <Button id="radio-prev" variant="secondary" size="sm" style="flex-grow: 1; justify-content: center;">
          <ButtonIcon><SkipBack></SkipBack></ButtonIcon>
        </Button>
        <Button id="radio-play" variant="primary" size="sm" style="flex-grow: 3; justify-content: center;">
          <ButtonIcon><Play></Play></ButtonIcon>
          <ButtonLabel class="btn-label-text"><span id="radio-play-label">Play Radio</span></ButtonLabel>
        </Button>
        <Button id="radio-next" variant="secondary" size="sm" style="flex-grow: 1; justify-content: center;">
          <ButtonIcon><SkipForward></SkipForward></ButtonIcon>
        </Button>
      </div>
    </div>

    <!-- Seccion Tornamesa (Scratch & Auto Beat) -->
    <div class="turntable-row">
      <Button id="btn-scratch" variant="primary" size="lg" style="flex-grow: 3; justify-content: center;">
        <ButtonIcon><Disc3></Disc3></ButtonIcon>
        <ButtonLabel class="btn-label-text"><span id="scratch-label">SCRATCH!</span></ButtonLabel>
      </Button>
      <Button id="btn-autobeat" variant="secondary" size="lg" style="flex-grow: 2; justify-content: center;">
        <ButtonIcon><Sparkles></Sparkles></ButtonIcon>
        <ButtonLabel class="btn-label-text"><span id="autobeat-label">Auto Beat</span></ButtonLabel>
      </Button>
    </div>

    <!-- Seccion LaunchPad FX & Drums -->
    <div class="section-label">LaunchPad</div>
    <div class="pad-grid">
      <div class="pad-row">
        <Button id="btn-kick" variant="secondary" size="sm" class="pad-btn">
          <ButtonLabel class="btn-label-text">Kick 808</ButtonLabel>
        </Button>
        <Button id="btn-snare" variant="secondary" size="sm" class="pad-btn">
          <ButtonLabel class="btn-label-text">Snare</ButtonLabel>
        </Button>
        <Button id="btn-hihat" variant="secondary" size="sm" class="pad-btn">
          <ButtonLabel class="btn-label-text">Hi-Hat</ButtonLabel>
        </Button>
      </div>
      <div class="pad-row">
        <Button id="btn-clap" variant="secondary" size="sm" class="pad-btn">
          <ButtonLabel class="btn-label-text">Clap</ButtonLabel>
        </Button>
        <Button id="btn-drop" variant="secondary" size="sm" class="pad-btn">
          <ButtonLabel class="btn-label-text">Bass Drop</ButtonLabel>
        </Button>
        <Button id="btn-laser" variant="secondary" size="sm" class="pad-btn">
          <ButtonLabel class="btn-label-text">Laser</ButtonLabel>
        </Button>
      </div>
    </div>

    <!-- Seccion Teclado Melodico (Notas 1 a 8) -->
    <div class="section-label">Teclado</div>
    <div class="keyboard-row">
      <Button id="btn-key-1" variant="secondary" size="sm" class="key-btn">
        <ButtonLabel class="btn-label-text">Do</ButtonLabel>
      </Button>
      <Button id="btn-key-2" variant="secondary" size="sm" class="key-btn">
        <ButtonLabel class="btn-label-text">Re</ButtonLabel>
      </Button>
      <Button id="btn-key-3" variant="secondary" size="sm" class="key-btn">
        <ButtonLabel class="btn-label-text">Mi</ButtonLabel>
      </Button>
      <Button id="btn-key-4" variant="secondary" size="sm" class="key-btn">
        <ButtonLabel class="btn-label-text">Fa</ButtonLabel>
      </Button>
      <Button id="btn-key-5" variant="secondary" size="sm" class="key-btn">
        <ButtonLabel class="btn-label-text">Sol</ButtonLabel>
      </Button>
      <Button id="btn-key-6" variant="secondary" size="sm" class="key-btn">
        <ButtonLabel class="btn-label-text">La</ButtonLabel>
      </Button>
      <Button id="btn-key-7" variant="secondary" size="sm" class="key-btn">
        <ButtonLabel class="btn-label-text">Si</ButtonLabel>
      </Button>
      <Button id="btn-key-8" variant="secondary" size="sm" class="key-btn">
        <ButtonLabel class="btn-label-text">Do'</ButtonLabel>
      </Button>
    </div>
  </div>
</Panel>
